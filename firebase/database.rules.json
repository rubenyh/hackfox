{
  /* Visit https://firebase.google.com/docs/database/security to learn more about security rules. */
  "rules": {
    ".read": false,
    ".write": false,
    "driverLocations": {
      "$driverId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $driverId) && (auth.token.role === 'driver' || auth.token.role === 'admin')"
      }
    }
  }
}
